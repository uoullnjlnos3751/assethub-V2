# ============================================================
# AssetHub v2.0 - Production Environment Configuration
# Copy this file to .env and fill in your actual production values
# ============================================================

# ============ Server ============
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://itam.trrgroup.com:5173
CORS_ORIGIN=http://itam.trrgroup.com:5173,http://itam.trrgroup.com,http://itsm.trrgroup.com:5173,http://itsm.trrgroup.com

# ============ Database (use strong password!) ============
DATABASE_URL=postgresql://assethub:CHANGE_THIS_PASSWORD@postgres:5432/assethub?schema=public

# ============ Auth (use strong random string!) ============
JWT_SECRET=GENERATE_A_VERY_LONG_RANDOM_STRING_HERE_MIN_32_CHARS
JWT_EXPIRES_IN=24h

# ============ LDAP/AD ============
LDAP_HOST=SRV-ADDS-02.trrgroup.com
LDAP_PORT=389
LDAP_BASE_DN=dc=trrgroup,dc=com
LDAP_DOMAIN=trrgroup
LDAP_SEARCH_USER=your-service-account@trrgroup.com
LDAP_SEARCH_PASSWORD=your-service-password

# ============ Email (Office365) ============
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=assethub@trrgroup.com
SMTP_PASS=your-office365-password
SMTP_FROM=AssetHub ITSM <assethub@trrgroup.com>

# ============ MS Teams Webhook (optional) ============
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/webhookb2/...

# ============ Borrow Settings ============
BORROW_DUE_DAYS=3

# ============ Backup Settings ============
BACKUP_RETENTION_DAYS=30

# ============ Features ============
ENABLE_AD_LOGIN=true
ENABLE_NOTIFICATIONS=true
ENABLE_AUTO_BACKUP=true
# NEVER set ALLOW_DEV_AUTH_BYPASS in production
