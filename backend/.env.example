# ============================================================
# AssetHub v2.0 - Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ============ Server ============
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ============ Database ============
DATABASE_URL=postgresql://assethub:assethub123@localhost:5433/assethub?schema=public

# ============ Auth ============
JWT_SECRET=CHANGE-THIS-TO-A-VERY-LONG-RANDOM-STRING-IN-PRODUCTION
JWT_EXPIRES_IN=24h
# Dev only: set to true to bypass LDAP for local testing (never enable in production)
# ALLOW_DEV_AUTH_BYPASS=true

# ============ LDAP/AD ============
LDAP_HOST=SRV-ADDS-02.trrgroup.com
LDAP_PORT=389
LDAP_BASE_DN=dc=trrgroup,dc=com
LDAP_DOMAIN=trrgroup
LDAP_SEARCH_USER=your-service-account
LDAP_SEARCH_PASSWORD=your-service-password

# ============ Email (Office365) ============
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@trrgroup.com
SMTP_PASS=your-email-password
SMTP_FROM=AssetITSM TRRT <your-email@trrgroup.com>

# ============ MS Teams ============
TEAMS_WEBHOOK_URL=

# ============ GLPI Integration ============
GLPI_API_URL=http://your-glpi-host/glpi/apirest.php
GLPI_USER_TOKEN=your-glpi-user-token
GLPI_APP_TOKEN=your-glpi-app-token

# ============ AI Chatbot (Google Gemini) ============
GEMINI_API_KEY=your-gemini-api-key

# ============ Borrow Settings ============
BORROW_DUE_DAYS=3

# ============ Rate Limiting ============
# Max credential-checking attempts (/api/auth/login, /api/auth/check-expiry)
# per IP per 15 minutes. Successful logins are not counted. Keep this below
# the Active Directory account lockout threshold.
LOGIN_RATE_LIMIT_MAX=15
