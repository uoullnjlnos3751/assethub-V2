# ============================================================
# AssetHub v2.0 - Backend Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# ============ Server ============
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Exact allowed origins, comma-separated (scheme + host + port must match).
CORS_ORIGIN=http://localhost:5173
# Optional, looser: hostnames allowed on any scheme/port. Use for a host
# reached by several URLs (bare host, :5173, http and https, raw IP).
# localhost and 127.0.0.1 are allowed automatically outside production.
CORS_ALLOWED_HOSTNAMES=

# ============ Request Body Limits ============
# Default JSON body cap. Images are uploaded as multipart/form-data, not JSON.
JSON_BODY_LIMIT=2mb
# Cap for /api/assets, which serves the bulk import (POST /assets/import/json).
IMPORT_BODY_LIMIT=25mb

# ============ Database ============
DATABASE_URL=postgresql://assethub:assethub123@localhost:5433/assethub?schema=public

# ============ Backup/Restore ============
# The backup feature shells out to pg_dump/psql. If they're not on the
# server's PATH, point these at the installed client tools directly (their
# major version doesn't need to match the DB server's).
# PG_DUMP_PATH=/usr/bin/pg_dump
# PSQL_PATH=/usr/bin/psql

# ============ Auth ============
JWT_SECRET=CHANGE-THIS-TO-A-VERY-LONG-RANDOM-STRING-IN-PRODUCTION
# The 30-minute idle logout in AuthContext is frontend-only — the token itself
# stays valid until this expires, regardless of idle time. Keep this short
# (hours, not days) so a stolen token has a small window.
JWT_EXPIRES_IN=24h
# Dev only: set to true to bypass LDAP for local testing (never enable in production)
# ALLOW_DEV_AUTH_BYPASS=true

# ============ LDAP/AD ============
LDAP_HOST=SRV-ADDS-02.trrgroup.com
LDAP_PORT=389
LDAP_BASE_DN=dc=trrgroup,dc=com
LDAP_DOMAIN=trrgroup
LDAP_SEARCH_USER=your-service-account
LDAP_SEARCH_PASSWORD=your-service-password

# ============ Email (Office365) ============
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=your-email@trrgroup.com
SMTP_PASS=your-email-password
SMTP_FROM=AssetITSM TRRT <your-email@trrgroup.com>

# ============ MS Teams ============
TEAMS_WEBHOOK_URL=

# ============ GLPI Integration ============
GLPI_API_URL=http://your-glpi-host/glpi/apirest.php
GLPI_USER_TOKEN=your-glpi-user-token
GLPI_APP_TOKEN=your-glpi-app-token

# ============ AI Chatbot (Google Gemini) ============
GEMINI_API_KEY=your-gemini-api-key

# ============ Borrow Settings ============
BORROW_DUE_DAYS=3

# ============ Rate Limiting ============
# Max credential-checking attempts (/api/auth/login, /api/auth/check-expiry)
# per IP per 15 minutes. Successful logins are not counted. Keep this below
# the Active Directory account lockout threshold.
LOGIN_RATE_LIMIT_MAX=15
