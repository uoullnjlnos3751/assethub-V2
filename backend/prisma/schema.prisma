generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppUser {
  id                 Int                 @id @default(autoincrement())
  adUsername         String              @unique
  displayName        String?
  email              String?
  department         String?
  company            String?
  companyThai        String?
  thaiName           String?
  avatarUrl          String?
  role               UserRole            @default(USER)
  isActive           Boolean             @default(true)
  authType           AuthType            @default(AD)
  passwordHash       String?
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  assetHistory       AssetHistory[]      @relation("ActorUser")
  assetHistoryOwner  AssetHistory[]      @relation("OwnerUser")
  borrowApprovals    BorrowApproval[]
  extensionRequests  BorrowExtension[]
  borrowRequests     BorrowRequest[]
  checkouts          Checkout[]
  pmRunsPerformed    PMRun[]             @relation("PMRunPerformedBy")
  returns            Return[]
  donations          Donation[]
  maintenanceRecords MaintenanceRecord[]
  notifications      AppNotification[]
  assignedAssets     Asset[]             @relation("AssetAssignedTo")
  disposalsCreated   AssetDisposal[]     @relation("DisposalCreatedBy")
  deliveryRequested  DeliveryRequest[]   @relation("DeliveryRequestedBy")
  deliveryInstalled  DeliveryRequest[]   @relation("DeliveryInstalledBy")
  deliveryDelivered  DeliveryRequest[]   @relation("DeliveryDeliveredBy")
  checklistRunsPerformed DeliveryChecklistRun[] @relation("DeliveryChecklistPerformedBy")

  @@index([role, isActive])
  @@index([department])
  @@map("app_users")
}

model Asset {
  id                  Int                  @id @default(autoincrement())
  assetCode           String?              @unique
  assetName           String?
  // เลขครุภัณฑ์ที่ฝ่ายบัญชีออกให้ — แยกจาก assetCode (รหัสที่ฝ่าย IT
  // สร้างอัตโนมัติ) เพราะฝ่ายบัญชีมักจะออกเลขทีหลัง หรือบางเครื่องไม่เคย
  // มีเลขนี้เลย จึงต้องเว้นว่างได้จนกว่าจะทราบ
  accountingCode      String?              @unique
  serialNo            String               @unique
  type                String?
  categoryId          Int?
  brand               String?
  model               String?
  cpu                 String?
  ram                 String?
  osVersion           String?
  windowsLicense      String?
  officeLicense       String?
  antivirusStatus     String?
  vendor              String?
  poNumber            String?
  prNumber            String?
  purchaseDate        DateTime?
  purchasePrice       Float?
  warrantyEndDate     DateTime?
  age                 Int?
  ownerName           String?
  departmentId        String?
  location            String?
  // ── Custody: "เครื่องนี้ฝากไว้ที่ไหน" ─────────────────────────────
  // Deliberately separate from `location` (IT's own field, and already
  // overloaded in the data) and from `status` (IT decides that, not the
  // holder). Plain String rather than an enum so a new drop-off point can be
  // opened by editing src/config/custodyHolders.ts — no migration needed.
  custodyHolder       String?              // e.g. "HR_TRR"; null = not held anywhere
  custodyNote         String?
  custodyUpdatedAt    DateTime?            // powers the "ฝากไว้กี่วันแล้ว" column
  custodyUpdatedById  Int?                 // no FK — AssetHistory keeps the real audit trail
  status              AssetStatus          @default(Available)
  remark              String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  company             String?
  oldAssetCode        String?
  cpuGeneration       String?
  domainName          String?
  floor               String?
  poDate              DateTime?
  ramDetail           String?
  gpu                 String?
  osType              String?
  budget              String?
  ramSlot1            String?
  ramSlot2            String?
  memoryType          String?
  ramOnboard          String?
  ramType             String?
  ramSpeed            String?
  ramMaxSupported     String?
  ramAvailableSlots   String?
  ramUpgradeable      String?
  snComputer          String?
  storage1            String?
  storage2            String?
  image               String?
  // ── Phase 2: ITAM lifecycle additions ──────────────────────────────
  // FK to assigned user (replaces free-text ownerName lookup)
  assignedToUserId    Int?
  assignedTo          AppUser?             @relation("AssetAssignedTo", fields: [assignedToUserId], references: [id])
  // Phase 5: FK to master data (dual-write — departmentId/vendor/location string columns
  // above stay as-is for display/fallback; these are resolved best-effort on write)
  departmentRefId     Int?
  departmentRef       Department?          @relation(fields: [departmentRefId], references: [id])
  vendorRefId         Int?
  vendorRef           Vendor?              @relation(fields: [vendorRefId], references: [id])
  locationRefId       Int?
  locationRef         AssetLocation?       @relation(fields: [locationRefId], references: [id])
  // Depreciation
  usefulLifeYears     Int?                 // e.g. 5 for laptops, 3 for phones
  salvageValue        Float?               // ราคาซากเมื่อหมดอายุ (บาท)
  // Procurement
  requesterName       String?              // ชื่อผู้ขอจัดซื้อ
  budgetCode          String?              // รหัสงบประมาณ
  receivedDate        DateTime?            // วันที่รับของจริง
  // ───────────────────────────────────────────────────────────────────
  assetHistory        AssetHistory[]       @relation("AssetHistoryAsset")
  borrowRequestItems  BorrowRequestItem[]
  pmRuns              PMRun[]
  computerDetail      ComputerDetail?
  phoneDetail         PhoneDetail?
  monitorDetail       MonitorDetail?
  deviceDetail        DeviceDetail?
  networkDeviceDetail NetworkDeviceDetail?
  rackDetail          RackDetail?
  printerDetail       PrinterDetail?
  cableDetail         CableDetail?
  consumableDetail    ConsumableDetail?
  category            Category?            @relation(fields: [categoryId], references: [id])
  donationItem        DonationItem?
  documents           AssetDocument[]
  maintenanceRecords  MaintenanceRecord[]
  floorPlanPins       FloorPlanPin[]
  // Phase 2
  disposals           AssetDisposal[]
  linkedParent        AssetLink[]          @relation("LinkChild")
  linkedChildren      AssetLink[]          @relation("LinkParent")
  contractAssets      ContractAsset[]
  deliveryRequests    DeliveryRequest[]

  @@index([status, departmentId, location])
  @@index([type, brand])
  @@index([status, createdAt])
  @@index([departmentId])
  @@index([departmentRefId])
  @@index([vendorRefId])
  @@index([locationRefId])
  @@index([categoryId])
  @@index([custodyHolder])
  @@map("assets")
}

model ComputerDetail {
  id              Int     @id @default(autoincrement())
  assetId         Int     @unique
  asset           Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cpu             String?
  cpuGeneration   String?
  ram             String?
  ramSlot1        String?
  ramSlot2        String?
  storage1        String?
  storage2        String?
  gpu             String?
  osType          String?
  osVersion       String?
  windowsLicense  String?
  officeLicense   String?
  antivirusStatus String?
  domainName      String?
  snComputer      String?

  @@map("computer_details")
}

model PhoneDetail {
  id              Int      @id @default(autoincrement())
  assetId         Int      @unique
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  imei1           String?
  imei2           String?
  osVersion       String?
  storageCapacity String?
  ram             String?
  phoneNumber     String?
  mdmEnrolled     Boolean?
  simProvider     String? // AIS, TrueMove, DTAC

  @@map("phone_details")
}

model MonitorDetail {
  id          Int      @id @default(autoincrement())
  assetId     Int      @unique
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  screenSize  String? // 24", 27", 34" Ultrawide
  resolution  String? // 1920x1080, 4K
  panelType   String? // IPS, VA, TN, OLED
  refreshRate String? // 60Hz, 144Hz, 240Hz
  ports       String? // HDMI, DisplayPort, USB-C
  hasSpeaker  Boolean?
  curved      Boolean?

  @@map("monitor_details")
}

model DeviceDetail {
  id             Int      @id @default(autoincrement())
  assetId        Int      @unique
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  deviceType     String? // Keyboard, Mouse, Headset, Webcam
  connectionType String? // USB, Wireless 2.4G, Bluetooth
  powerSource    String? // Battery AA, Rechargeable, USB Powered
  rgbSupport     Boolean?

  @@map("device_details")
}

model NetworkDeviceDetail {
  id              Int      @id @default(autoincrement())
  assetId         Int      @unique
  asset           Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  networkType     String? // Switch, Router, Firewall, Access Point
  ipAddress       String?
  macAddress      String?
  firmwareVersion String?
  portCount       Int?
  locationRack    String?
  poeSupport      Boolean?

  @@map("network_device_details")
}

model RackDetail {
  id            Int     @id @default(autoincrement())
  assetId       Int     @unique
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  subType       String? // Rack, Enclosure, PDU
  rackUnits     String?
  powerCapacity String?
  rackLocation  String?

  @@map("rack_details")
}

model PrinterDetail {
  id            Int      @id @default(autoincrement())
  assetId       Int      @unique
  asset         Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  printerType   String? // Laser, Inkjet, Dot Matrix, Thermal
  isColor       Boolean?
  networkReady  Boolean?
  ipAddress     String?
  macAddress    String?
  pageCount     Int?
  duplexSupport Boolean?

  @@map("printer_details")
}

model CableDetail {
  id            Int     @id @default(autoincrement())
  assetId       Int     @unique
  asset         Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  cableType     String? // HDMI, LAN CAT6, USB-C to Lightning
  length        String? // 1.5m, 3m, 5m
  stockQuantity Int?
  minimumStock  Int?

  @@map("cable_details")
}

model ConsumableDetail {
  id             Int       @id @default(autoincrement())
  assetId        Int       @unique
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  consumableType String? // Toner, Ink Cartridge, ถ่าน AA
  compatibleWith String? // Printer Brother HL-L2320D etc.
  stockQuantity  Int?
  minimumStock   Int?
  expiryDate     DateTime?

  @@map("consumable_details")
}

model AssetDocument {
  id         Int      @id @default(autoincrement())
  assetId    Int
  fileName   String
  storedName String
  fileSize   Int
  mimeType   String
  docType    String   @default("OTHER")
  note       String?
  uploadedBy String?
  createdAt  DateTime @default(now())
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId])
  @@map("asset_documents")
}

// ── Phase 2: ITAM lifecycle additions ──────────────────────────────────────

// CMDB parent-child relationships (e.g. โน้ตบุ๊ก ↔ dock, คอม ↔ จอ)
model AssetLink {
  id          Int      @id @default(autoincrement())
  parentId    Int
  childId     Int
  linkType    String   @default("COMPONENT")  // COMPONENT | CONNECTED | DEPENDS_ON
  note        String?
  createdAt   DateTime @default(now())

  parent      Asset    @relation("LinkParent", fields: [parentId], references: [id], onDelete: Cascade)
  child       Asset    @relation("LinkChild",  fields: [childId],  references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([parentId])
  @@index([childId])
  @@map("asset_links")
}

// การจำหน่ายทรัพย์สินออก (บริจาค / ขาย / ทำลาย / คืน vendor)
model AssetDisposal {
  id             Int             @id @default(autoincrement())
  assetId        Int
  asset          Asset           @relation(fields: [assetId], references: [id])
  method         DisposalMethod
  disposalDate   DateTime
  approvedBy     String?         // ชื่อผู้อนุมัติ / เลขที่คำสั่ง
  approvalRef    String?         // เอกสารอ้างอิง
  saleValue      Float?          // ราคาขาย (ถ้าวิธีคือ SELL)
  recipientName  String?         // ผู้รับบริจาค/ซื้อ
  notes          String?
  createdById    Int
  createdBy      AppUser         @relation("DisposalCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now())

  @@index([assetId])
  @@index([disposalDate])
  @@map("asset_disposals")
}

enum DisposalMethod {
  DONATE    // บริจาค
  SELL      // ขายซาก
  DESTROY   // ทำลาย/e-waste
  RETURN    // คืน vendor / leasing
  TRANSFER  // โอนย้ายภายใน
}

// ─────────────────────────────────────────────────────────────────────────────

model InventoryItem {
  id                Int                    @id @default(autoincrement())
  name              String
  category          String // Cable, Cartridge, Consumable, Other
  brand             String?
  model             String?
  totalQuantity     Int                    @default(0)
  availableQuantity Int                    @default(0)
  minStockLevel     Int                    @default(0)
  unit              String // ชิ้น, ม้วน, เส้น, ตลับ, etc.
  location          String?
  remark            String?
  image             String?
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  transactions      InventoryTransaction[]
  borrowItems       BorrowRequestItem[]    @relation("InventoryBorrowItems")

  @@index([category, isActive])
  @@index([name])
  @@map("inventory_items")
}

model InventoryTransaction {
  id        Int           @id @default(autoincrement())
  itemId    Int
  item      InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  action    String // checkin, checkout
  quantity  Int
  userId    Int?
  userName  String?
  note      String?
  refNo     String? // Reference number (e.g. borrow request no)
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model DeviceType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("device_types")
}

model Company {
  id                Int      @id @default(autoincrement())
  code              String?  @unique
  name              String   @unique
  nameEng           String?
  logoUrl           String?
  description       String?
  assetCompanyCodes String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("companies")
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  nameEng     String?
  code        String   @unique
  logoUrl     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@map("departments")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  icon        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  types  CategoryType[]
  assets Asset[]

  @@map("categories")
}

model CategoryType {
  id           Int      @id @default(autoincrement())
  categoryId   Int
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  detailTable  String? // "computer_details", "phone_details", etc.
  isBorrowable Boolean  @default(true)
  isAssignable Boolean  @default(true)
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([categoryId, name])
  @@map("category_types")
}

model AssetLocation {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  company     String?

  assets      Asset[]

  @@map("asset_locations")
}

model Vendor {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assets      Asset[]

  @@map("vendors")
}

model AssetStatusMaster {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("asset_status_masters")
}

model Printer {
  id          Int      @id @default(autoincrement())
  floorArea   String
  brandModel  String
  serialNo    String?
  ipAddress   String?
  driver      String?
  pinNote     String?
  status      String   @default("active")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("printers")
}

model ChecklistSet {
  id                     Int      @id @default(autoincrement())
  docCode                String   @unique
  name                   String
  appliesToCategories    String?
  itemCount              Int      @default(0)
  categoryCount          Int      @default(0)
  avgTimeLabel           String?
  revision               Int      @default(1)
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  items                  ChecklistItem[]
  checklistRuns          DeliveryChecklistRun[]

  @@map("checklist_sets")
}

model ChecklistItem {
  id          Int          @id @default(autoincrement())
  setId       Int
  set         ChecklistSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  category    String
  refCode     String
  itemText    String
  answerType  String       @default("PASS_FAIL_NA")
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  answers     DeliveryChecklistAnswer[]

  @@index([setId, sortOrder])
  @@map("checklist_items")
}

model DeliveryChecklistRun {
  id             Int                       @id @default(autoincrement())
  requestId      Int
  request        DeliveryRequest           @relation(fields: [requestId], references: [id], onDelete: Cascade)
  checklistSetId Int
  checklistSet   ChecklistSet              @relation(fields: [checklistSetId], references: [id])
  status         String                    @default("DRAFT")
  performedBy    Int?
  performer      AppUser?                  @relation("DeliveryChecklistPerformedBy", fields: [performedBy], references: [id])
  performedAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  answers        DeliveryChecklistAnswer[]

  @@index([requestId])
  @@map("delivery_checklist_runs")
}

model DeliveryChecklistAnswer {
  id     Int                  @id @default(autoincrement())
  runId  Int
  run    DeliveryChecklistRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  itemId Int
  item   ChecklistItem        @relation(fields: [itemId], references: [id])
  value  String?
  note   String?

  @@unique([runId, itemId])
  @@map("delivery_checklist_answers")
}

model AssetHistory {
  id          Int      @id @default(autoincrement())
  assetId     Int
  actionType  String
  fromStatus  String?
  toStatus    String?
  fromOwner   String?
  toOwner     String?
  fromDept    String?
  toDept      String?
  fromLoc     String?
  toLoc       String?
  note        String?
  actorUserId Int?
  ownerUserId Int?
  createdAt   DateTime @default(now())
  actor       AppUser? @relation("ActorUser", fields: [actorUserId], references: [id])
  asset       Asset    @relation("AssetHistoryAsset", fields: [assetId], references: [id])
  owner       AppUser? @relation("OwnerUser", fields: [ownerUserId], references: [id])

  @@index([assetId])
  @@map("asset_history")
}

model BorrowRequest {
  id              Int                 @id @default(autoincrement())
  requestNo       String              @unique
  requesterUserId Int
  departmentId    String?
  purpose         String?
  status          BorrowRequestStatus @default(Pending)
  note            String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  approvals       BorrowApproval[]
  extensions      BorrowExtension[]
  items           BorrowRequestItem[]
  requester       AppUser             @relation(fields: [requesterUserId], references: [id])
  checkouts       Checkout[]

  @@index([requesterUserId, status])
  @@index([status, createdAt])
  @@index([departmentId])
  @@map("borrow_requests")
}

model BorrowRequestItem {
  id              Int                   @id @default(autoincrement())
  requestId       Int
  assetId         Int?
  inventoryItemId Int?
  isQuantityBased Boolean               @default(false)
  quantity        Int                   @default(1)
  borrowDate      DateTime?
  dueDate         DateTime?
  itemStatus      BorrowItemStatus      @default(Pending)
  note            String?
  extensions      BorrowExtensionItem[]
  asset           Asset?                @relation(fields: [assetId], references: [id])
  inventoryItem   InventoryItem?        @relation("InventoryBorrowItems", fields: [inventoryItemId], references: [id])
  request         BorrowRequest         @relation(fields: [requestId], references: [id])
  returns         Return[]

  @@index([assetId, itemStatus, dueDate])
  @@index([requestId, itemStatus])
  @@index([dueDate, itemStatus])
  @@index([inventoryItemId])
  @@map("borrow_request_items")
}

model BorrowApproval {
  id             Int           @id @default(autoincrement())
  requestId      Int
  approverUserId Int
  action         String
  note           String?
  actedAt        DateTime      @default(now())
  approver       AppUser       @relation(fields: [approverUserId], references: [id])
  request        BorrowRequest @relation(fields: [requestId], references: [id])

  @@map("borrow_approvals")
}

model Checkout {
  id            Int             @id @default(autoincrement())
  requestId     Int
  checkoutBy    Int
  receivedBy    String?
  checkoutAt    DateTime        @default(now())
  handoverNote  String?
  // Base64 PNG data URL from the on-screen signature pad — small enough
  // (a few KB) that storing it as text alongside the row is reasonable,
  // unlike the photo evidence below which goes to disk like every other
  // evidence-photo model in this schema (see MaintenanceImage).
  signatureData String?
  checker       AppUser         @relation(fields: [checkoutBy], references: [id])
  request       BorrowRequest   @relation(fields: [requestId], references: [id])
  images        CheckoutImage[]

  @@map("checkouts")
}

model CheckoutImage {
  id          Int      @id @default(autoincrement())
  checkoutId  Int
  checkout    Checkout @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

  @@map("checkout_images")
}

model Return {
  id              Int               @id @default(autoincrement())
  requestItemId   Int
  returnBy        Int
  returnedAt      DateTime          @default(now())
  condition       ReturnCondition
  damageNote      String?
  accessoriesNote String?
  receiverName    String?
  signatureData   String?
  requestItem     BorrowRequestItem @relation(fields: [requestItemId], references: [id])
  returner        AppUser           @relation(fields: [returnBy], references: [id])
  images          ReturnImage[]

  @@map("returns")
}

model ReturnImage {
  id          Int      @id @default(autoincrement())
  returnId    Int
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  imageUrl    String
  description String?
  createdAt   DateTime @default(now())

  @@map("return_images")
}

model BorrowExtension {
  id           Int                   @id @default(autoincrement())
  requestId    Int
  requestedBy  Int
  status       ExtensionStatus       @default(Pending)
  reason       String?
  createdAt    DateTime              @default(now())
  decidedAt    DateTime?
  decidedBy    Int?
  decisionNote String?
  items        BorrowExtensionItem[]
  request      BorrowRequest         @relation(fields: [requestId], references: [id])
  requester    AppUser               @relation(fields: [requestedBy], references: [id])

  @@map("borrow_extensions")
}

model BorrowExtensionItem {
  id               Int               @id @default(autoincrement())
  extensionId      Int
  requestItemId    Int
  oldDueDate       DateTime
  requestedDueDate DateTime
  extraDays        Int
  extension        BorrowExtension   @relation(fields: [extensionId], references: [id])
  requestItem      BorrowRequestItem @relation(fields: [requestItemId], references: [id])

  @@map("borrow_extension_items")
}

model PMTemplate {
  id            Int              @id @default(autoincrement())
  year          Int
  name          String
  description   String?
  active        Boolean          @default(true)
  plans         PMPlan[]
  templateItems PMTemplateItem[]

  @@map("pm_templates")
}

model PMTemplateItem {
  id         Int           @id @default(autoincrement())
  templateId Int
  key        String
  label      String
  type       String
  required   Boolean       @default(false)
  group      String?
  order      Int           @default(0)
  answers    PMRunAnswer[]
  template   PMTemplate    @relation(fields: [templateId], references: [id])

  @@map("pm_template_items")
}

model PMPlan {
  id                 Int        @id @default(autoincrement())
  year               Int
  site               String?
  deptTask           String?
  company            String?
  lead               String?
  deviceType         String?
  plannedDeviceCount Int
  startDate          DateTime?
  endDate            DateTime?
  templateId         Int
  isAdhoc            Boolean    @default(false)
  template           PMTemplate @relation(fields: [templateId], references: [id])
  runs               PMRun[]

  @@index([year])
  @@map("pm_plans")
}

model PMRun {
  id          Int           @id @default(autoincrement())
  planId      Int
  assetId     Int
  year        Int
  status      PMRunStatus   @default(DRAFT)
  performedBy Int?
  performedAt DateTime?
  completedAt DateTime?
  photoUrl    String?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt @default(now())
  answers     PMRunAnswer[]
  asset       Asset         @relation(fields: [assetId], references: [id])
  performer   AppUser?      @relation("PMRunPerformedBy", fields: [performedBy], references: [id])
  plan        PMPlan        @relation(fields: [planId], references: [id])

  @@unique([assetId, year], name: "unique_asset_year_completed")
  @@index([planId, status])
  @@index([assetId, year])
  @@index([status, performedAt])
  @@index([year, status])
  @@map("pm_runs")
}

model PMRunAnswer {
  id     Int            @id @default(autoincrement())
  runId  Int
  itemId Int
  value  String?
  item   PMTemplateItem @relation(fields: [itemId], references: [id])
  run    PMRun          @relation(fields: [runId], references: [id])

  @@map("pm_run_answers")
}

// ── New Devices & Delivery (เครื่องใหม่ & ส่งมอบ) ───────────────────────────
// Phase A: register device + peripherals, deliver with a self-generated
// email-confirmation link (no Power Automate / MS Forms dependency — the
// confirmToken is resolved by a public, unauthenticated route+page).
enum DeliveryType {
  NEW_PURCHASE
  RECYCLED
  TEMP_REPLACEMENT
}

enum DeliveryStatus {
  DRAFT
  SETUP_IN_PROGRESS
  SETUP_DONE
  PENDING_DELIVERY
  DELIVERED
  CONFIRMED
  RETURN_REQUESTED
  RETURNED
}

model DeliveryRequest {
  id               Int                      @id @default(autoincrement())
  deliveryType     DeliveryType             @default(NEW_PURCHASE)
  status           DeliveryStatus           @default(DRAFT)
  assetId          Int?
  asset            Asset?                   @relation(fields: [assetId], references: [id])
  recipientName    String
  recipientEmail   String?
  recipientDept    String?
  recipientCompany String?
  source           String?
  requestedBy      Int
  requester        AppUser                  @relation("DeliveryRequestedBy", fields: [requestedBy], references: [id])
  installerId      Int?
  installer        AppUser?                 @relation("DeliveryInstalledBy", fields: [installerId], references: [id])
  installedAt      DateTime?
  deliveredById    Int?
  deliveredBy      AppUser?                 @relation("DeliveryDeliveredBy", fields: [deliveredById], references: [id])
  deliveredAt      DateTime?
  confirmToken     String?                  @unique
  confirmedAt      DateTime?
  confirmMethod    String?
  notes            String?
  peripherals      DeliveryPeripheralItem[]
  checklistRuns    DeliveryChecklistRun[]
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  @@index([status])
  @@map("delivery_requests")
}

model DeliveryPeripheralItem {
  id        Int             @id @default(autoincrement())
  requestId Int
  request   DeliveryRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category  String
  itemName  String
  serialNo  String?
  qty       Int             @default(1)
  remark    String?
  prepared  Boolean         @default(false)
  delivered Boolean         @default(false)

  @@map("delivery_peripheral_items")
}

model NotificationTemplate {
  id        Int                 @id @default(autoincrement())
  key       String
  channel   NotificationChannel
  subjectTh String
  bodyTh    String

  @@unique([key, channel])
  @@map("notification_templates")
}

model NotificationOutbox {
  id          Int                 @id @default(autoincrement())
  eventType   String
  channel     NotificationChannel
  recipient   String
  payloadJson String
  status      NotificationStatus  @default(PENDING)
  retryCount  Int                 @default(0)
  lastError   String?
  createdAt   DateTime            @default(now())
  sentAt      DateTime?

  @@index([status, channel])
  @@index([createdAt])
  @@map("notification_outbox")
}

model AppNotification {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   @default("SYSTEM")
  link      String?
  createdAt DateTime @default(now())
  user      AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("app_notifications")
}

model NotificationSetting {
  id Int @id @default(autoincrement())

  // General
  systemName        String  @default("ITAM")
  organizationName  String  @default("TRR Group")
  logoUrl           String?
  timezone          String  @default("Asia/Bangkok")
  darkMode          Boolean @default(false)
  showWelcomeBanner Boolean @default(true)

  // Borrow Rules
  borrowDays              Int     @default(3)
  maxBorrowDays           Int     @default(30)
  maxItemsPerRequest      Int     @default(5)
  allowExtension          Boolean @default(true)
  maxExtensionsPerRequest Int     @default(2)
  overdueWarningDays      Int     @default(3)

  // Notifications
  enableEmail      Boolean @default(true)
  enableTeams      Boolean @default(false)
  teamsWebhookUrl  String?
  enabledEventKeys String  @default("borrow_request_pending,borrow_approved,borrow_rejected,checkout_completed,return_recorded,overdue_borrow,extension_pending,extension_approved,extension_rejected,pm_overdue")

  // SMTP (can override env vars)
  smtpHost      String?
  smtpPort      String  @default("587")
  smtpUser      String?
  smtpPass      String?
  smtpFromEmail String?
  smtpFromName  String?
  emailCc       String?

  // LINE
  enableLine             Boolean @default(false)
  lineChannelAccessToken String?
  lineWebhookUrl         String?
  lineWebhookVerifyToken String?
  lineSendMode           String  @default("broadcast")
  lineUserIds            String?
  lineEnabledStatuses    String  @default("รอรับเรื่อง,รับเรื่องแล้ว,กำลังดำเนินการ,รอชิ้นส่วน,เสร็จสิ้น,ยกเลิก")

  // Security
  requireStrongPassword Boolean @default(true)
  passwordExpiryDays    Int     @default(90)
  sessionTimeoutHours   Int     @default(8)

  @@map("notification_settings")
}

model SystemSetting {
  id          Int      @id @default(autoincrement())
  group       String   @default("GENERAL") // e.g., 'ASSET_GENERATION'
  key         String   @unique
  value       String   // JSON text or plain string
  description String?
  updatedAt   DateTime @updatedAt
  updatedBy   Int?     // User ID who last updated
}

model ScheduledJob {
  id          Int       @id @default(autoincrement())
  jobType     String
  status      String
  result      String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("scheduled_jobs")
}

// ── Phase 3: License & Contract management ──────────────────────────────────

model SoftwareLicense {
  id              Int                   @id @default(autoincrement())
  name            String                // ชื่อซอฟต์แวร์ เช่น "Microsoft 365 Business"
  vendor          String?
  licenseType     String                @default("PERPETUAL") // PERPETUAL | SUBSCRIPTION | OEM | VOLUME
  totalSeats      Int                   @default(1)           // จำนวนสิทธิ์รวม
  licenseKey      String?               // serial / activation key (เข้ารหัสในอนาคต)
  purchaseDate    DateTime?
  expiryDate      DateTime?             // null = ไม่มีวันหมดอายุ (perpetual)
  purchasePrice   Float?
  poNumber        String?
  notes           String?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  assignments     LicenseAssignment[]

  @@index([expiryDate])
  @@map("software_licenses")
}

model LicenseAssignment {
  id          Int              @id @default(autoincrement())
  licenseId   Int
  license     SoftwareLicense  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  assetId     Int?
  userId      Int?
  assignedAt  DateTime         @default(now())
  note        String?

  @@unique([licenseId, assetId])
  @@unique([licenseId, userId])
  @@index([licenseId])
  @@map("license_assignments")
}

// สัญญาและ warranty (MA, leasing, ประกัน)
model Contract {
  id            Int              @id @default(autoincrement())
  title         String           // ชื่อสัญญา
  contractNo    String?          @unique
  contractType  String           @default("WARRANTY") // WARRANTY | MA | LEASE | INSURANCE | SUPPORT
  vendor        String?
  startDate     DateTime
  endDate       DateTime         // วันหมดสัญญา — ระบบจะแจ้งเตือน 30/60/90 วันก่อน
  value         Float?           // มูลค่าสัญญา (บาท)
  poNumber      String?
  notes         String?
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  assets        ContractAsset[]

  @@index([endDate, isActive])
  @@map("contracts")
}

// asset ที่อยู่ภายใต้สัญญา (one contract → many assets)
model ContractAsset {
  id         Int      @id @default(autoincrement())
  contractId Int
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetId    Int
  asset      Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([contractId, assetId])
  @@index([contractId])
  @@index([assetId])
  @@map("contract_assets")
}

