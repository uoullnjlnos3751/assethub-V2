}

model MaintenanceImage {
  id          Int               @id @default(autoincrement())
  recordId    Int
  record      MaintenanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  imageType   String
  imageUrl    String
  description String?
  createdAt   DateTime          @default(now())

