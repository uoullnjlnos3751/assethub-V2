model PMSwHub {
  id         Int      @id @default(autoincrement())
  planId     Int?
  formId     String   @unique
  floor      String
  date       DateTime
  technician String
  period     String
  remark     String?
  signTech   String?
  signMgr    String?
  status     String   @default("Pending") // Pass, Fail, Pending
  photoBeforeUrl String?
  photoAfterUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  plan       PMSwHubPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  items      PMSwHubItem[]

  @@map("pm_sw_hubs")
}

model PMSwHubPlan {
  id                 Int       @id @default(autoincrement())
  year               Int
  floor              String
  period             String    // 'Monthly' | 'Quarterly' | 'Annual'
  startDate          DateTime?
  endDate            DateTime?
  technician         String?
  status             String    @default("Pending") // 'Pending', 'Completed'
  templateId         Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  
  template           PMSwHubTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  swHubs             PMSwHub[] 

  @@map("pm_sw_hub_plans")
}

model PMSwHubItem {
  id            Int       @id @default(autoincrement())
  pmSwHubId     Int
  category      String
  checkItem     String
  status        String? // pass, fail, na
  note          String?
  photoUrl      String?
  resolveStatus String? // open, inprogress, resolved (only for fail)
  resolvedAt    DateTime?

  pmSwHub PMSwHub @relation(fields: [pmSwHubId], references: [id], onDelete: Cascade)

  @@map("pm_sw_hub_items")
}

model PMSwHubTemplate {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  items       PMSwHubTemplateItem[]
  plans       PMSwHubPlan[]
  
  @@map("pm_sw_hub_templates")
}

model PMSwHubTemplateItem {
  id         Int             @id @default(autoincrement())
  templateId Int
  template   PMSwHubTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  group      String          // 'power', 'network', 'env', 'physical', 'cable'
  key        String
  label      String
  type       String          @default("boolean")
  required   Boolean         @default(false)
  order      Int             @default(0)
  
  @@map("pm_sw_hub_template_items")
}

model FloorPlan {
  id        Int            @id @default(autoincrement())
  name      String
  floor     String
  building  String?
  company   String?
  imageUrl  String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  pins      FloorPlanPin[]

  @@map("floor_plans")
}

model FloorPlanPin {
  id          Int       @id @default(autoincrement())
  floorPlanId Int
  floorPlan   FloorPlan @relation(fields: [floorPlanId], references: [id], onDelete: Cascade)
  assetId     Int
  asset       Asset     @relation(fields: [assetId], references: [id])
  x           Float
  y           Float
  label       String?
  createdAt   DateTime  @default(now())

  @@unique([floorPlanId, assetId])
  @@map("floor_plan_pins")
}
